# GP-TARS container tag. Use `main` for automatic updates or pin a commit SHA/release tag.
GPTARS_TAG=main

# GHCR namespace
GHCR_NAMESPACE=ghcr.io/scottmeddings/gptars_v2

# Persistent host paths
GPTARS_DATA=/opt/gptars/data
GPTARS_CONFIG=/opt/gptars/config

# Database
POSTGRES_DB=gptars
POSTGRES_USER=gptars
POSTGRES_PASSWORD=CHANGE_ME_NOW

# Core networking
TARS_API_PORT=8080
TARS_DISPLAY_PORT=8090
TARS_LLM_PORT=8081

# Local model path/name is deliberately configurable.
TARS_MODEL_FILE=/models/current.gguf

# Automatic update interval in seconds
WATCHTOWER_POLL_INTERVAL=300

# Set to true only after CUDA validation on the Ubuntu host.
ENABLE_CUDA=true
